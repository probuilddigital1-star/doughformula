---
import Layout from '../layouts/Layout.astro';
import { Image, getImage } from 'astro:assets';
import heroImage from '../assets/hero-bread.jpg';
import { KIT_FORM_ID, KIT_PUBLIC_API_KEY, NEWSLETTER_ENABLED } from '../config/newsletter';
import EquipmentGrid from '../components/EquipmentGrid.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import FeaturedGearCard from '../components/FeaturedGearCard.astro';
import { HOMEPAGE_PRODUCTS, TRACKING_IDS, GEAR_SETS, CALCULATOR_STYLE_FAMILY, ALL_GEAR_PRODUCT_IDS, FEATURED_GEAR, hasDirectMerchant } from '../data/equipment';
import { BREAD_STYLES } from '../lib/bread-styles';
import {
  HYDRATION_MAX,
  HYDRATION_MIN,
  LOAF_WEIGHT_MAX,
  blendForWholeGrain,
  calculateRecipe,
  calculateWaterTemp,
  createDefaultEnrichments,
  createDefaultState,
  estimateFermentationTimes,
  formatTemp,
  formatWeight,
  ingredientRows,
  starterHydrationNote,
  waterTempFormulaText,
  waterTempText,
  yeastSliderRange,
} from '../lib/bread-calculator';

// 750 covers the common 375-412px phones at 1.75 to 2x; 1080 covers 3x phones and tablets.
// The 4000x6000 source never ships. Quality 50 is invisible under the hero's cream overlay.
const heroWidths = [480, 750, 1080, 1600];
const HERO_QUALITY = 50;
const heroVariants = await Promise.all(
  heroWidths.map((w) =>
    getImage({ src: heroImage, width: w, quality: HERO_QUALITY, format: 'webp' })
  )
);
const heroPreloadSrcset = heroVariants
  .map((v, i) => `${v.src} ${heroWidths[i]}w`)
  .join(', ');

// Bread style icons (SVG paths)
const icons = {
  sourdough: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="16" cy="18" rx="12" ry="8"/><path d="M8 14c2-4 6-6 8-6s6 2 8 6"/><path d="M12 18c1-2 3-3 4-3s3 1 4 3"/></svg>`,
  baguette: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22c-1-2-1-4 0-6 2-4 8-8 14-10 2 0 4 1 5 3 1 2 1 5-1 7-3 4-10 8-16 9-1 0-2-1-2-3z"/><path d="M10 16l3-3M14 18l3-3M18 14l2-2"/></svg>`,
  focaccia: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10" width="22" height="14" rx="3"/><circle cx="10" cy="17" r="1.5"/><circle cx="16" cy="14" r="1.5"/><circle cx="22" cy="17" r="1.5"/><circle cx="13" cy="20" r="1.5"/><circle cx="19" cy="20" r="1.5"/></svg>`,
  sandwich: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="8" width="18" height="16" rx="4"/><path d="M7 16h18"/><path d="M10 12h2M14 12h2"/></svg>`,
  ciabatta: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18c0-3 2-6 6-7h12c4 1 6 4 6 7s-2 5-5 6H9c-3-1-5-3-5-6z"/><circle cx="11" cy="16" r="1"/><circle cx="16" cy="18" r="1.5"/><circle cx="21" cy="15" r="1"/><circle cx="14" cy="14" r="0.75"/></svg>`,
  brioche: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="10" r="5"/><ellipse cx="16" cy="21" rx="8" ry="6"/><path d="M12 15c0 1 2 2 4 2s4-1 4-2"/></svg>`,
  noknead: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="16" r="11"/><path d="M16 8v8l5 3"/></svg>`,
  custom: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="16" r="3"/><path d="M16 6v3M16 23v3M6 16h3M23 16h3"/><path d="M9.5 9.5l2 2M20.5 20.5l2 2M9.5 22.5l2-2M20.5 11.5l2-2"/></svg>`
};

// Bread style data lives in src/lib/bread-styles.ts (the words) and src/lib/bread-calculator.ts
// (the recipe settings), so the calculator tests sweep the same styles the cards carry. The
// icons stay here.
const styleIcons: Record<string, string> = { ...icons, 'no-knead': icons.noknead };
const breadStyles = BREAD_STYLES.map((style) => ({ ...style, icon: styleIcons[style.id] }));

// Styles whose own method bakes in a Dutch oven. Read from the instructions rather than listed,
// so a style that gains or loses a Dutch oven step gains or loses the featured card with it.
const DUTCH_OVEN_STYLES = breadStyles
  .filter((style) => style.instructions.some((step) => /dutch oven/i.test(step)))
  .map((style) => style.id);
const featuredGear = FEATURED_GEAR['dutch-oven'];
// breadStyles[0] is selected on load; its card state is server-rendered so nothing shifts.
const featuredOnLoad = DUTCH_OVEN_STYLES.includes(breadStyles[0].id);
// The starter hydration line under the ingredient list, server-rendered for the default
// recipe so nothing shifts when the script fills the list in.
const defaultState = createDefaultState();
const starterNoteOnLoad = starterHydrationNote(defaultState);
// The same goes for the water temperature: the server HTML shows what the script will.
const waterTempOnLoad = calculateWaterTemp(defaultState);
const timesOnLoad = estimateFermentationTimes(defaultState);
// And for the recipe itself. The whole default recipe is in the server HTML, built by the
// code the script runs, so a plain visit has nothing to work out or draw on load. The script
// renders from the first change on.
const enrichmentsOnLoad = createDefaultEnrichments();
const blendOnLoad = blendForWholeGrain(defaultState.wholeGrain);
const recipeOnLoad = calculateRecipe(defaultState, enrichmentsOnLoad, blendOnLoad);
const rowsOnLoad = ingredientRows(defaultState, enrichmentsOnLoad, recipeOnLoad);
const yeastRangeOnLoad = yeastSliderRange(defaultState.yeastType);
---

<Layout>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      imagesrcset={heroPreloadSrcset}
      imagesizes="100vw"
      fetchpriority="high"
    />
  </Fragment>
  <main id="main-content">
  <!-- Hero Section - Full Bleed Editorial -->
  <section class="hero-editorial">
    <!-- Background Image with Ken Burns -->
    <div class="hero-bg-image">
      <Image
        src={heroImage}
        alt="Freshly baked artisan sourdough bread with beautiful open crumb, sliced and displayed with rosemary"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width={1600}
        height={2400}
        widths={heroWidths}
        sizes="100vw"
        quality={HERO_QUALITY}
        format="webp"
      />
    </div>

    <!-- Content Overlay -->
    <div class="hero-content container">
      <div class="max-w-2xl">
        <p class="animate-rise delay-1 text-sm tracking-[0.25em] text-[var(--accent-gold)] font-medium mb-6 flex items-center gap-4">
          <span class="w-12 h-px bg-[var(--accent-gold)]"></span>
          FOR HOME BAKERS
        </p>
        <h1 class="animate-rise delay-2 font-display text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-medium mb-2 leading-[0.9]">
          The Art of
        </h1>
        <p class="animate-rise delay-3 font-display text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-medium italic text-[var(--accent-gold)] mb-8 leading-[0.9]">
          Perfect Bread
        </p>
        <p class="animate-rise delay-4 font-editorial text-xl md:text-2xl text-[var(--crust-brown)] max-w-lg mb-10 leading-relaxed">
          Master baker's percentages. Calculate precise recipes for sourdough, baguettes, focaccia, and beyond.
        </p>
        <a href="#calculator" class="animate-rise delay-5 btn btn-primary text-lg px-8 py-4 inline-flex">
          Begin Your Bake
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="scroll-indicator hidden md:flex">
      <span>Scroll</span>
    </div>
  </section>

  <!-- Transition Divider -->
  <div class="py-8 scoring-divider">╱ ╱ ╱</div>

  <!-- Calculator Section -->
  <section id="calculator" class="py-12 md:py-20">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12">

        <!-- Left Column: Style Selection & Quantity -->
        <div class="space-y-8">
          <!-- Bread Styles -->
          <div id="bread-styles">
            <h2 class="text-2xl font-display mb-2">Choose Your Style</h2>
            <p class="text-[var(--crust-brown)] mb-6">Select a style for recommended settings, or go custom.</p>

            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3" id="style-grid">
              {breadStyles.map((style, index) => (
                <button
                  class={`card p-4 text-left cursor-pointer hover:shadow-md transition-all style-card ${index === 0 ? 'card-selected' : ''}`}
                  data-style={style.id}
                  data-hydration={style.hydration}
                  data-salt={style.salt}
                  data-yeast-type={style.yeastType}
                  data-yeast-percent={style.yeastPercent}
                  data-whole-grain={style.wholeGrain}
                  data-flour={style.flour}
                  data-instructions={JSON.stringify(style.instructions)}
                >
                  <span class="w-8 h-8 mb-2 block text-[var(--accent-gold)]" set:html={style.icon}></span>
                  <span class="font-medium block">{style.name}</span>
                  <span class="text-sm text-[var(--crust-brown)] block mt-1">{style.description}</span>
                </button>
              ))}
            </div>

            <!-- Pizza Dough CTA -->
            <div class="pizza-cta mt-6" id="pizza-cta">
              <a href="https://thepizzadoughformula.com" target="_blank" rel="noopener" class="pizza-cta-link group">
                <div class="pizza-cta-content">
                  <div class="pizza-cta-icon">
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
                      <circle cx="16" cy="16" r="12"/>
                      <path d="M16 4v24M4 16h24"/>
                      <circle cx="11" cy="11" r="1.5" fill="currentColor"/>
                      <circle cx="20" cy="13" r="1" fill="currentColor"/>
                      <circle cx="13" cy="19" r="1.5" fill="currentColor"/>
                      <circle cx="19" cy="20" r="1" fill="currentColor"/>
                    </svg>
                  </div>
                  <div class="pizza-cta-text">
                    <span class="pizza-cta-label">Making Pizza?</span>
                    <span class="pizza-cta-headline">Discover <em>The Pizza Dough Formula</em></span>
                    <span class="pizza-cta-subtext">Neapolitan, New York, Detroit, and more. Precision-crafted for the perfect pie.</span>
                  </div>
                  <div class="pizza-cta-arrow">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 transition-transform group-hover:translate-x-1">
                      <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
                    </svg>
                  </div>
                </div>
              </a>
            </div>
          </div>

          <!-- Dough Quantity -->
          <div class="card p-4 sm:p-6">
            <h3 class="text-lg font-display mb-4">Dough Quantity</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 mb-4">
              <div>
                <label for="num-loaves" class="block text-sm text-[var(--crust-brown)] mb-2">Number of Loaves</label>
                <div class="flex items-center gap-2">
                  <input
                    type="number"
                    id="num-loaves"
                    value="2"
                    min="1"
                    max="12"
                    class="input input-number"
                    aria-label="Number of loaves"
                  />
                  <span class="text-[var(--crust-brown)]" aria-hidden="true">loaves</span>
                </div>
              </div>
              <div>
                <label for="loaf-weight" class="block text-sm text-[var(--crust-brown)] mb-2">Weight per Loaf</label>
                <div class="flex items-center gap-2">
                  <input
                    type="number"
                    id="loaf-weight"
                    value="900"
                    min="200"
                    max={LOAF_WEIGHT_MAX}
                    step="50"
                    class="input input-number"
                    aria-label="Weight per loaf in grams"
                  />
                  <span class="text-[var(--crust-brown)]" aria-hidden="true">g</span>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between py-3 px-4 bg-[var(--cream-warm)] rounded-lg mb-4">
              <span class="text-[var(--crust-brown)]">Total Dough Weight:</span>
              <span class="text-xl font-semibold text-[var(--accent-gold)]" id="total-weight">1800g</span>
            </div>

            <div class="flex flex-wrap gap-2">
              <span class="text-sm text-[var(--crust-brown)]">Quick presets:</span>
              <button class="preset-pill" data-loaves="1" data-weight="500">1 loaf</button>
              <button class="preset-pill preset-pill-active" data-loaves="2" data-weight="900">2 loaves</button>
              <button class="preset-pill" data-loaves="4" data-weight="900">4 loaves</button>
            </div>
          </div>

          <!-- Advanced Options - Tabbed Interface -->
          <div class="card p-0">
            <div class="accordion-item border-0">
              <button class="accordion-trigger px-4 sm:px-6 py-4" id="advanced-trigger" aria-expanded="true" aria-controls="advanced-content">
                <span class="flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
                  </svg>
                  Advanced Options
                </span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transition-transform" id="advanced-chevron" style="transform: rotate(180deg)" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </button>
              <div id="advanced-content">
                <!-- Tab Navigation - Wrapping Grid -->
                <div class="advanced-tabs-grid" id="tabs-wrapper">
                    <button class="advanced-tab advanced-tab-active" data-tab="basics">Basics</button>
                    <button class="advanced-tab" data-tab="yeast">Yeast</button>
                    <button class="advanced-tab" data-tab="flour">Flour</button>
                    <button class="advanced-tab" data-tab="enrichments">Enrichments</button>
                    <button class="advanced-tab" data-tab="temperature">Temperature</button>
                    <button class="advanced-tab" data-tab="timing">Timing</button>
                    <button class="advanced-tab" data-tab="preferments">Preferments</button>
                </div>

                <!-- Tab: Basics -->
                <div class="advanced-tab-content p-4 sm:p-6 space-y-4" id="tab-basics">
                  <div>
                    <label for="hydration-slider" class="flex justify-between text-sm mb-2">
                      <span>Hydration</span>
                      <span class="font-medium" id="hydration-value">75%</span>
                    </label>
                    <input type="range" id="hydration-slider" min={HYDRATION_MIN} max={HYDRATION_MAX} value="75" class="w-full accent-[var(--accent-gold)]" aria-label="Hydration percentage" />
                  </div>
                  <div>
                    <label for="whole-grain-slider" class="flex justify-between text-sm mb-2">
                      <span>Whole Grain</span>
                      <span class="font-medium" id="whole-grain-value">10%</span>
                    </label>
                    <input type="range" id="whole-grain-slider" min="0" max="50" value="10" class="w-full accent-[var(--accent-gold)]" aria-label="Whole grain percentage" />
                  </div>
                  <div>
                    <label for="salt-slider" class="flex justify-between text-sm mb-2">
                      <span>Salt</span>
                      <span class="font-medium" id="salt-value">2%</span>
                    </label>
                    <input type="range" id="salt-slider" min="1.5" max="3" value="2" step="0.1" class="w-full accent-[var(--accent-gold)]" aria-label="Salt percentage" />
                  </div>
                </div>

                <!-- Tab: Yeast -->
                <div class="advanced-tab-content hidden p-4 sm:p-6 space-y-4" id="tab-yeast">
                  <div>
                    <label class="block text-sm mb-2">Yeast Type</label>
                    <div class="grid grid-cols-2 gap-2" id="yeast-type-selector">
                      <button class="yeast-type-btn yeast-type-active" data-yeast="starter">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                          <circle cx="12" cy="12" r="8"/>
                          <circle cx="9" cy="10" r="1.5" fill="currentColor"/>
                          <circle cx="15" cy="11" r="1" fill="currentColor"/>
                          <circle cx="11" cy="14" r="1.5" fill="currentColor"/>
                          <circle cx="14" cy="15" r="0.75" fill="currentColor"/>
                        </svg>
                        <span>Starter</span>
                      </button>
                      <button class="yeast-type-btn" data-yeast="instant">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                          <rect x="7" y="4" width="10" height="16" rx="2"/>
                          <line x1="7" y1="8" x2="17" y2="8"/>
                          <circle cx="12" cy="14" r="2" fill="currentColor"/>
                        </svg>
                        <span>Instant</span>
                      </button>
                      <button class="yeast-type-btn" data-yeast="active-dry">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                          <rect x="6" y="6" width="12" height="12" rx="1"/>
                          <circle cx="10" cy="12" r="1" fill="currentColor"/>
                          <circle cx="14" cy="10" r="1" fill="currentColor"/>
                          <circle cx="12" cy="14" r="1" fill="currentColor"/>
                        </svg>
                        <span>Active Dry</span>
                      </button>
                      <button class="yeast-type-btn" data-yeast="fresh">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                          <rect x="5" y="8" width="14" height="8" rx="2"/>
                          <path d="M8 8V6a2 2 0 012-2h4a2 2 0 012 2v2"/>
                        </svg>
                        <span>Fresh</span>
                      </button>
                    </div>
                  </div>

                  <!-- Yeast Percentage (for commercial yeast) -->
                  <div id="yeast-percent-control">
                    <label for="yeast-percent-slider" class="flex justify-between text-sm mb-2">
                      <span id="yeast-percent-label">Starter Amount</span>
                      <span class="font-medium" id="yeast-percent-value">20%</span>
                    </label>
                    <input type="range" id="yeast-percent-slider" min={yeastRangeOnLoad.min} max={yeastRangeOnLoad.max} value={defaultState.yeastPercent} step={yeastRangeOnLoad.step} class="w-full accent-[var(--accent-gold)]" />
                    <p id="yeast-levain-note" class="hidden text-xs text-[var(--crust-brown)] mt-1">With a levain on, the levain is your starter. Set its size on the Preferments tab.</p>
                  </div>

                  <!-- Starter Hydration (only for sourdough starter) -->
                  <div id="starter-hydration-control">
                    <label for="starter-hydration-slider" class="flex justify-between text-sm mb-2">
                      <span>Starter Hydration</span>
                      <span class="font-medium" id="starter-hydration-value">100%</span>
                    </label>
                    <input type="range" id="starter-hydration-slider" min="50" max="200" value="100" class="w-full accent-[var(--accent-gold)]" />
                    <p class="text-xs text-[var(--crust-brown)] mt-1">100% = equal parts flour and water in your starter</p>
                  </div>

                  <!-- Yeast Tips -->
                  <div class="bg-[var(--cream-warm)] rounded-lg p-3 mt-3" id="yeast-tip">
                    <p class="text-sm text-[var(--crust-brown)]">
                      <span class="font-medium text-[var(--espresso)]">Tip:</span>
                      <span id="yeast-tip-text">Feed your starter 4-8 hours before use. Use at peak activity when it's domed and bubbly.</span>
                    </p>
                  </div>

                  <!-- Starter Contribution Info -->
                  <div id="starter-contribution" class="bg-[var(--accent-gold)]/10 rounded-lg p-3 border border-[var(--accent-gold)]/20">
                    <p class="text-sm font-medium text-[var(--espresso)] mb-1">Starter Contribution:</p>
                    <p class="text-sm text-[var(--crust-brown)]">
                      Your starter adds <span id="starter-flour-contrib" class="font-medium">{formatWeight(defaultState, recipeOnLoad.starterFlourContrib)}</span> flour and <span id="starter-water-contrib" class="font-medium">{formatWeight(defaultState, recipeOnLoad.starterWaterContrib)}</span> water to the dough.
                    </p>
                  </div>
                </div>

                <!-- Tab: Flour -->
                <div class="advanced-tab-content hidden p-4 sm:p-6 space-y-4" id="tab-flour">
                  <p class="text-sm text-[var(--crust-brown)] mb-2">
                    Blend multiple flours for unique flavor and texture profiles.
                  </p>

                  <!-- Primary Flour -->
                  <div class="flour-entry" data-flour-index="0">
                    <div class="flex items-center gap-2 mb-2">
                      <select class="flour-type-select input flex-1 py-2" data-flour="0">
                        <option value="bread">Bread Flour (12-14% protein)</option>
                        <option value="ap">All-Purpose (10-12% protein)</option>
                        <option value="whole-wheat">Whole Wheat</option>
                        <option value="rye-light">Light Rye</option>
                        <option value="rye-dark">Dark Rye</option>
                        <option value="spelt">Spelt</option>
                        <option value="einkorn">Einkorn</option>
                        <option value="semolina">Semolina/Durum</option>
                        <option value="tipo-00">Tipo 00</option>
                      </select>
                      <div class="flex items-center gap-1">
                        <input type="number" class="flour-percent-input input w-16 text-center py-2" value={blendOnLoad[0].percent} min="0" max="100" data-flour="0" />
