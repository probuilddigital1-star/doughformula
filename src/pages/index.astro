                      <span class="text-sm font-medium text-[var(--espresso)]">Effective Hydration:</span>
                      <span class="text-lg font-display font-semibold text-[var(--accent-gold)]" id="effective-hydration">72%</span>
                    </div>
                    <p class="text-xs text-[var(--crust-brown)]">
                      Target: <span id="target-hydration">75</span>% → Adjusted for enrichments
                    </p>
                    <div class="mt-2 text-xs text-[var(--crust-brown)]" id="enrichment-breakdown">
                      <!-- Breakdown populated by JS -->
                    </div>
                  </div>

                  <!-- Enrichment Tips -->
                  <div class="bg-[var(--cream-warm)] rounded-lg p-3">
                    <p class="text-sm text-[var(--crust-brown)]">
                      <span class="font-medium text-[var(--espresso)]">Tip:</span>
                      <span id="enrichment-tip">Add fats after initial gluten development for better dough structure.</span>
                    </p>
                  </div>
                </div>

                <!-- Tab: Temperature -->
                <div class="advanced-tab-content hidden p-4 sm:p-6 space-y-4" id="tab-temperature">
                  <!-- Temperature Unit Toggle -->
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-sm font-medium">Temperature Unit</span>
                    <div class="flex items-center gap-1 bg-[var(--cream-warm)] rounded-full p-1">
                      <button class="px-3 py-1 rounded-full text-sm font-medium text-[var(--crust-brown)]" id="temp-unit-c">°C</button>
                      <button class="px-3 py-1 rounded-full text-sm font-medium bg-[var(--espresso)] text-white" id="temp-unit-f">°F</button>
                    </div>
                  </div>

                  <!-- DDT Input -->
                  <div>
                    <label for="ddt-input" class="flex justify-between text-sm mb-2">
                      <span class="flex items-center gap-1">
                        Desired Dough Temp (DDT)
                        <button class="text-[var(--crust-brown)] hover:text-[var(--espresso)]" title="Target temperature for your dough after mixing">
                          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                          </svg>
                        </button>
                      </span>
                      <span class="font-medium" id="ddt-value">{formatTemp(defaultState, defaultState.ddt)}</span>
                    </label>
                    <input type="range" id="ddt-slider" min="68" max="86" value={defaultState.ddt} class="w-full accent-[var(--accent-gold)]" />
                  </div>

                  <!-- Room Temperature -->
                  <div>
                    <label for="room-temp-input" class="flex justify-between text-sm mb-2">
                      <span>Room Temperature</span>
                      <span class="font-medium" id="room-temp-value">70°F</span>
                    </label>
                    <input type="range" id="room-temp-slider" min="60" max="90" value="70" class="w-full accent-[var(--accent-gold)]" />
                  </div>

                  <!-- Flour Temperature -->
                  <div>
                    <label for="flour-temp-input" class="flex justify-between text-sm mb-2">
                      <span>Flour Temperature</span>
                      <span class="font-medium" id="flour-temp-value">70°F</span>
                    </label>
                    <input type="range" id="flour-temp-slider" min="55" max="85" value="70" class="w-full accent-[var(--accent-gold)]" />
                    <p class="text-xs text-[var(--crust-brown)] mt-1">Usually same as room temp, unless stored in a cool place</p>
                  </div>

                  <!-- Mixer Type -->
                  <div>
                    <label class="block text-sm mb-2">Mixing Method</label>
                    <div class="grid grid-cols-3 gap-2" id="mixer-selector">
                      <button class="mixer-btn mixer-btn-active" data-mixer="hand" data-friction="11">
                        <span class="text-xs">Hand</span>
                      </button>
                      <button class="mixer-btn" data-mixer="stand" data-friction="22">
                        <span class="text-xs">Stand Mixer</span>
                      </button>
                      <button class="mixer-btn" data-mixer="spiral" data-friction="32">
                        <span class="text-xs">Spiral</span>
                      </button>
                    </div>
                    <p class="text-xs text-[var(--crust-brown)] mt-1">Friction factor: <span id="friction-value">11°F</span></p>
                  </div>

                  <!-- Calculated Water Temperature -->
                  <div class="bg-[var(--accent-gold)]/10 rounded-lg p-4 border border-[var(--accent-gold)]/20">
                    <div class="flex items-center justify-between">
                      <span class="text-sm font-medium text-[var(--espresso)]">Use Water At:</span>
                      <span class="text-2xl font-display font-semibold text-[var(--accent-gold)]" id="calc-water-temp">{formatTemp(defaultState, waterTempOnLoad)}</span>
                    </div>
                    <p class="text-xs text-[var(--crust-brown)] mt-2" id="water-temp-formula">{waterTempFormulaText(defaultState, waterTempOnLoad)}</p>
                    <div id="water-temp-warning" class="hidden mt-2 text-xs text-red-600 font-medium">
                      ⚠️ Water temperature is outside safe range
                    </div>
                  </div>
                </div>

                <!-- Tab: Timing -->
                <div class="advanced-tab-content hidden p-4 sm:p-6 space-y-4" id="tab-timing">
                  <p class="text-sm text-[var(--crust-brown)] mb-4">
                    Estimated times based on your dough temperature and yeast type. Watch the dough, not the clock!
                  </p>

                  <!-- Bulk Fermentation -->
                  <div class="bg-[var(--cream-warm)] rounded-lg p-4">
                    <div class="flex items-center justify-between mb-2">
                      <span class="font-medium text-[var(--espresso)]">Bulk Fermentation</span>
                      <span class="text-lg font-display font-semibold text-[var(--accent-gold)]" id="bulk-time">{timesOnLoad.bulk}</span>
                    </div>
                    <p class="text-xs text-[var(--crust-brown)]" id="bulk-description">
                      Look for 50-75% rise with visible bubbles. Dough should be airy and jiggly.
                    </p>
                  </div>

                  <!-- Final Proof -->
                  <div class="bg-[var(--cream-warm)] rounded-lg p-4">
                    <div class="flex items-center justify-between mb-2">
                      <span class="font-medium text-[var(--espresso)]">Final Proof</span>
                      <span class="text-lg font-display font-semibold text-[var(--accent-gold)]" id="proof-time">{timesOnLoad.proof}</span>
                    </div>
                    <p class="text-xs text-[var(--crust-brown)]" id="proof-description">
                      Poke test: dough should spring back slowly but not completely.
                    </p>
                  </div>

                  <!-- Cold Retard Option -->
                  <div class="flex items-center justify-between py-3 px-4 bg-[var(--cream-warm)] rounded-lg">
                    <div>
                      <span class="font-medium text-[var(--espresso)]">Cold Retard</span>
                      <p class="text-xs text-[var(--crust-brown)]">Overnight in refrigerator</p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                      <input type="checkbox" id="cold-retard-toggle" class="sr-only peer">
                      <div class="w-11 h-6 bg-[var(--border-light)] peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[var(--accent-gold)]"></div>
                    </label>
                  </div>

                  <div id="cold-retard-info" class="hidden bg-blue-50 rounded-lg p-3 border border-blue-200">
