                      </button>
                    </div>
                  </div>

                  <div id="flour-slot-2" class="flour-entry hidden" data-flour-index="2">
                    <div class="flex items-center gap-2 mb-2">
                      <select class="flour-type-select input flex-1 py-2" data-flour="2">
                        <option value="bread">Bread Flour</option>
                        <option value="ap">All-Purpose</option>
                        <option value="whole-wheat">Whole Wheat</option>
                        <option value="rye-light" selected>Light Rye</option>
                        <option value="rye-dark">Dark Rye</option>
                        <option value="spelt">Spelt</option>
                        <option value="einkorn">Einkorn</option>
                        <option value="semolina">Semolina/Durum</option>
                        <option value="tipo-00">Tipo 00</option>
                      </select>
                      <div class="flex items-center gap-1">
                        <input type="number" class="flour-percent-input input w-16 text-center py-2" value="0" min="0" max="100" data-flour="2" />
                        <span class="text-sm text-[var(--crust-brown)]">%</span>
                      </div>
                      <button class="remove-flour-btn text-[var(--crust-brown)] hover:text-red-500 p-1" data-flour="2">
                        <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                      </button>
                    </div>
                  </div>

                  <!-- Add Flour Button -->
                  <button id="add-flour-btn" class="btn btn-outline w-full text-sm py-2">
                    <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" /></svg>
                    Add Another Flour
                  </button>

                  <!-- Flour Percentage Validation -->
                  <div id="flour-validation" class="hidden text-sm text-red-600 bg-red-50 p-2 rounded">
