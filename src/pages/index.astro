          <h3 class="font-display text-xl mb-2">Troubleshooting</h3>
          <p class="text-[var(--crust-brown)] text-sm leading-relaxed">Diagnose gummy crumb, flat loaves, overproofed dough, and more.</p>
        </a>
        <a href="/guides/" class="card block p-6 hover:shadow-md transition-all bg-[var(--cream-warm)]">
          <h3 class="font-display text-xl mb-2">All Guides</h3>
          <p class="text-[var(--crust-brown)] text-sm leading-relaxed">Browse the full library of articles in one place.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="py-16" id="about">
    <div class="container max-w-3xl">
      <div class="text-center mb-10">
        <p class="text-sm tracking-[0.2em] text-[var(--accent-gold)] font-medium mb-4">ABOUT</p>
        <h2 class="font-display text-3xl md:text-4xl mb-4">The Dough Formula</h2>
      </div>

      <div class="prose prose-lg mx-auto text-[var(--crust-brown)]">
        <p class="text-lg leading-relaxed mb-6">
          The Dough Formula was created for home bakers who want to understand the science behind great bread.
          Whether you're baking your first loaf or perfecting your sourdough, our calculator helps you
          achieve consistent, delicious results every time.
        </p>
        <p class="text-lg leading-relaxed mb-6">
          We believe that understanding baker's percentages is the key to becoming a confident bread baker.
          Instead of following recipes blindly, you'll learn to read formulas, adjust for your environment,
          and create your own signature loaves.
        </p>
        <p class="text-lg leading-relaxed">
          This tool is free and always will be. We're passionate about bread and want to share that passion
          with bakers everywhere. Happy baking! 🌾
        </p>
      </div>

      <div class="scoring-divider mt-12">╱ ╱ ╱</div>
    </div>
  </section>

  <!-- Equipment Section -->
  <section class="py-16" id="equipment">
    <div class="container">
      <EquipmentGrid
        productIds={HOMEPAGE_PRODUCTS}
        trackingId={TRACKING_IDS.homepage}
        heading="Essential Bread Equipment"
        intro="The right tools make all the difference"
      />
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 bg-[var(--cream-warm)]" id="faq">
    <div class="container max-w-3xl">
      <h2 class="font-display text-2xl md:text-3xl text-center mb-10">Frequently Asked Questions</h2>

      <div class="space-y-3" id="faq-list">
        <div class="accordion-item">
          <button class="accordion-trigger faq-trigger">
            What hydration is best for beginners?
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transition-transform faq-chevron" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="accordion-content hidden">
            Start with 65-70% hydration. Lower hydration doughs are easier to handle and shape. As you gain experience, gradually increase to 75-80% for more open crumb.
          </div>
        </div>

        <div class="accordion-item">
          <button class="accordion-trigger faq-trigger">
            Can I use all-purpose flour instead of bread flour?
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transition-transform faq-chevron" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="accordion-content hidden">
            Yes, but reduce hydration by 3-5%. All-purpose flour has less protein (10-12% vs 12-14% for bread flour), so it absorbs less water and produces a slightly softer crumb.
          </div>
        </div>

        <div class="accordion-item">
          <button class="accordion-trigger faq-trigger">
            Why is my bread dense?
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transition-transform faq-chevron" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="accordion-content hidden">
            Common causes: underproofed dough (not enough fermentation time), weak/inactive starter, cold dough temperature, or not enough gluten development. Try longer bulk ferment and ensure your starter passes the float test.
          </div>
        </div>

        <div class="accordion-item">
          <button class="accordion-trigger faq-trigger">
            Why use baker's percentages?
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transition-transform faq-chevron" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="accordion-content hidden">
            Baker's percentages make scaling recipes easy and allow you to compare recipes at a glance. All ingredients are expressed as a percentage of the flour weight (flour is always 100%), so you can instantly see hydration, salt level, and other ratios.
          </div>
        </div>

        <div class="accordion-item">
          <button class="accordion-trigger faq-trigger">
            Do I need a Dutch oven?
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transition-transform faq-chevron" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="accordion-content hidden">
            Not required, but highly recommended for home ovens. It traps steam, giving you the crispy crust and oven spring that's hard to achieve otherwise. Alternatives: baking stone with steam pan, or inverted roasting pan.
          </div>
        </div>
      </div>
    </div>
  </section>

  </main>

  <!-- Toast -->
  <div class="toast" id="toast" role="alert" aria-live="polite"></div>

  <!-- Baking Schedule Modal -->
  <div id="schedule-modal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" id="schedule-modal-overlay"></div>
    <div class="absolute inset-4 sm:inset-auto sm:top-1/2 sm:left-1/2 sm:-translate-x-1/2 sm:-translate-y-1/2 sm:max-w-lg sm:w-full bg-[var(--cream-flour)] rounded-xl shadow-2xl overflow-hidden">
      <div class="p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-display text-xl">Plan My Bake</h3>
          <button id="schedule-modal-close" class="p-2 hover:bg-[var(--cream-warm)] rounded-lg transition-colors">
            <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
        </div>

        <p class="text-sm text-[var(--crust-brown)] mb-4">
          When do you want fresh bread ready?
        </p>

        <div class="space-y-4">
          <!-- Date/Time Input -->
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-sm text-[var(--crust-brown)] mb-1">Date</label>
              <input type="date" id="schedule-date" class="input w-full py-2" />
            </div>
            <div>
              <label class="block text-sm text-[var(--crust-brown)] mb-1">Time</label>
              <input type="time" id="schedule-time" class="input w-full py-2" value="09:00" />
            </div>
          </div>

          <!-- Quick Presets -->
          <div>
            <p class="text-xs text-[var(--crust-brown)] mb-2">Quick presets:</p>
            <div class="flex flex-wrap gap-2">
              <button class="schedule-preset-btn preset-pill text-xs" data-preset="morning">Tomorrow morning</button>
              <button class="schedule-preset-btn preset-pill text-xs" data-preset="lunch">Tomorrow lunch</button>
              <button class="schedule-preset-btn preset-pill text-xs" data-preset="dinner">Tomorrow dinner</button>
            </div>
          </div>

          <!-- Generate Button -->
          <button id="generate-schedule-btn" class="btn btn-primary w-full py-3">
            Generate Schedule
          </button>
        </div>

        <!-- Generated Schedule (hidden initially) -->
        <div id="schedule-result" class="hidden mt-6 pt-6 border-t border-[var(--border-light)]">
          <h4 class="font-medium text-[var(--espresso)] mb-3">Your Baking Timeline</h4>
          <div class="space-y-2" id="schedule-timeline">
            <!-- Timeline items populated by JS -->
          </div>

          <div class="mt-4 pt-4 border-t border-[var(--border-light)] flex gap-2">
            <button id="copy-schedule-btn" class="btn btn-outline flex-1 text-sm py-2">
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                <path d="M8 3a1 1 0 011-1h2a1 1 0 110 2H9a1 1 0 01-1-1z" />
                <path d="M6 3a2 2 0 00-2 2v11a2 2 0 002 2h8a2 2 0 002-2V5a2 2 0 00-2-2 3 3 0 01-3 3H9a3 3 0 01-3-3z" />
              </svg>
              Copy
            </button>
            <button id="download-ics-btn" class="btn btn-gold flex-1 text-sm py-2">
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
              </svg>
              Add to Calendar
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // ============================================
  // Calculator State & Logic
  // ============================================
  // The math and the printed values live in src/lib/bread-calculator.ts, where the tests run
  // them. This script keeps the state objects and the DOM wiring.
  import * as calc from '../lib/bread-calculator';
  import type { EnrichmentState, FlourEntry, RecipeState, YeastType } from '../lib/bread-calculator';

  const PREFERMENT_DATA = calc.PREFERMENT_DATA;
  const YEAST_TIPS = calc.YEAST_TIPS;

  const state: RecipeState = calc.createDefaultState();
  const enrichmentState: EnrichmentState = calc.createDefaultEnrichments();
  // The recipe is built on flourBlend. The Flour tab edits flourDraft, and the draft becomes
  // the blend only when it adds up to 100%, so a half-typed blend can never print a recipe
  // with negative flour.
  const flourBlend: FlourEntry[] = calc.blendForWholeGrain(state.wholeGrain);
  let flourDraft: FlourEntry[] = flourBlend.map((flour) => ({ ...flour }));

  // Get initial instructions from first style card
  const firstCard = document.querySelector('.style-card') as HTMLElement;
  if (firstCard) {
    state.instructions = JSON.parse(firstCard.dataset.instructions || '[]');
  }

  // The bake schedule, the calendar file, Copy and Share run on a click, so their code stays
  // out of this script. It is fetched once the page has loaded and is idle, and a click that
  // comes before then waits for it.
  type Actions = typeof import('../lib/bread-calculator-actions');
  let actionsModule: Promise<Actions> | null = null;
  const loadActions = (): Promise<Actions> => (actionsModule ??= import('../lib/bread-calculator-actions'));
  const whenIdle = (work: () => void) => {
    if ('requestIdleCallback' in window) window.requestIdleCallback(work);
    else setTimeout(work, 2000);
  };
  if (document.readyState === 'complete') whenIdle(() => void loadActions());
  else window.addEventListener('load', () => whenIdle(() => void loadActions()));

  // The shared math, bound to this page's state
  const formatTemp = (tempF: number) => calc.formatTemp(state, tempF);
  const formatWeight = (grams: number) => calc.formatWeight(state, grams);
  const estimateFermentationTimes = () => calc.estimateFermentationTimes(state);
  const estimatePrefermentTiming = () => calc.estimatePrefermentTiming(state);
  const calculateRecipe = () => calc.calculateRecipe(state, enrichmentState, flourBlend);

  function updateUI() {
    const recipe = calculateRecipe();

    // Update total weight display
    const totalWeightEl = document.getElementById('total-weight');
    if (totalWeightEl) {
      totalWeightEl.textContent = formatWeight(recipe.totalDough);
    }

    // Update recipe card title
    const titleEl = document.getElementById('recipe-title');
    if (titleEl) {
      titleEl.textContent = calc.recipeTitle(state);
    }

    // Show the gear list for the selected style's shape family. The map is server-rendered
    // onto the aside because this script is processed TypeScript and cannot use define:vars.
    const gearBlock = document.getElementById('gear-block');
    if (gearBlock) {
      const familyMap = JSON.parse(gearBlock.dataset.styleFamily || '{}') as Record<string, string>;
      const family = familyMap[state.style] ?? 'universal';
      gearBlock.querySelectorAll<HTMLElement>('[data-gear-family]').forEach((el) => {
        el.classList.toggle('hidden', el.dataset.gearFamily !== family);
      });
      // The featured card, and the disclosure's other-retailers sentence that goes with it,
      // show only for styles that bake in a Dutch oven.
      const featuredStyles = JSON.parse(gearBlock.dataset.featuredStyles || '[]') as string[];
      const showFeatured = featuredStyles.includes(state.style);
      gearBlock.querySelectorAll<HTMLElement>('[data-featured-wrap], [data-other-retailers]').forEach((el) => {
        el.classList.toggle('hidden', !showFeatured);
      });
    }

    // Update recipe yield
    const yieldEl = document.getElementById('recipe-yield');
    if (yieldEl) {
      yieldEl.textContent = calc.yieldText(state, recipe);
    }

    // Update preferment section visibility and content
    const prefermentSection = document.getElementById('preferment-section');
    const ingredientsHeading = document.getElementById('ingredients-heading-text');
    const prefIngredients = recipe.preferment;

    if (prefermentSection && ingredientsHeading) {
      if (state.prefermentType !== 'none' && prefIngredients) {
        prefermentSection.classList.remove('hidden');
        ingredientsHeading.textContent = 'Final Dough';

        // Update preferment section details
        const prefData = PREFERMENT_DATA[state.prefermentType];
        const prefTitle = document.getElementById('preferment-title');
        const prefTimingBadge = document.getElementById('preferment-timing-badge');
        const prefReadySigns = document.getElementById('recipe-preferment-ready-signs');
        const prefIngList = document.getElementById('preferment-ingredients-list');

        if (prefTitle) prefTitle.textContent = prefData.name.toUpperCase();
        if (prefTimingBadge) prefTimingBadge.textContent = `Make ${prefData.fermentTimeMin}-${prefData.fermentTimeMax} hrs before`;
        if (prefReadySigns) prefReadySigns.textContent = prefData.readySigns;

        // Build preferment ingredients list
        if (prefIngList) {
          const prefIngs = calc.prefermentRows(state, recipe);

          prefIngList.innerHTML = prefIngs.map(ing => `
            <div class="flex justify-between py-1.5 border-b border-[var(--border-light)] last:border-0">
              <span class="font-medium">${ing.name}</span>
              <span class="flex gap-2">
                <span>${formatWeight(ing.weight)}</span>
                ${ing.note ? `<span class="text-xs text-[var(--crust-brown)]">${ing.note}</span>` : ''}
              </span>
            </div>
          `).join('');
        }
      } else {
        prefermentSection.classList.add('hidden');
        ingredientsHeading.textContent = 'Ingredients';
      }
    }

    // Update ingredients list (Final Dough when preferment active)
    const ingredientsList = document.getElementById('ingredients-list');
    if (ingredientsList) {
      const ingredients = calc.ingredientRows(state, enrichmentState, recipe);

      ingredientsList.innerHTML = ingredients.map(ing => `
        <div class="flex justify-between py-2 border-b border-[var(--border-light)]">
          <span>${ing.name}${ing.note ? ` <span class="text-xs text-[var(--crust-brown)]">${ing.note}</span>` : ''}</span>
          <span class="flex gap-4">
            <span class="font-medium">${formatWeight(ing.weight)}</span>
            ${ing.percent >= 0 ? `<span class="text-[var(--crust-brown)] w-16 text-right">(${ing.percent}%)</span>` : '<span class="w-16"></span>'}
          </span>
        </div>
      `).join('');
    }

    // A style's eggs follow the batch size, so the count field shows the count in use
    if (enrichmentState.eggs.enabled && enrichmentState.eggs.percentOfFlour && enrichmentState.eggs.count !== recipe.eggCountAsked) {
      enrichmentState.eggs.count = recipe.eggCountAsked;
      const eggCountEl = document.getElementById('egg-count') as HTMLInputElement | null;
      if (eggCountEl) eggCountEl.value = String(recipe.eggCountAsked);
      updateEggWeight();
    }

    // With a starter, say what the hydration is once the starter's flour and water count
    const starterNoteEl = document.getElementById('starter-hydration-note');
    if (starterNoteEl) {
      const starterNote = calc.starterHydrationNote(state);
      starterNoteEl.textContent = starterNote ?? '';
      starterNoteEl.classList.toggle('hidden', starterNote === null);
    }

    // Update tips - now show calculated water temperature
    const waterTempEl = document.getElementById('water-temp');
    if (waterTempEl) {
      waterTempEl.textContent = calc.waterTempText(state, recipe.calculatedWaterTemp);
    }

    // Active dry yeast is bloomed in warm water first, whatever the dough's water temperature
    const bloomNoteEl = document.getElementById('bloom-note');
    if (bloomNoteEl) {
      const bloomNote = calc.yeastBloomNote(state);
      bloomNoteEl.textContent = bloomNote ?? '';
      bloomNoteEl.classList.toggle('hidden', bloomNote === null);
    }

    const flourRecEl = document.getElementById('flour-rec');
    if (flourRecEl) {
      flourRecEl.textContent = state.flour;
    }

    // Update instructions
    const instructionsList = document.getElementById('instructions-list');
    if (instructionsList && state.instructions.length > 0) {
      instructionsList.innerHTML = state.instructions.map((inst, i) => `
        <li class="flex gap-3">
          <span class="flex-shrink-0 w-6 h-6 rounded-full bg-[var(--accent-gold)] text-white text-sm flex items-center justify-center">${i + 1}</span>
          <span class="text-[var(--crust-brown)]">${inst}</span>
        </li>
      `).join('');
    }

    // Update slider displays - Basics tab
    const hydrationValue = document.getElementById('hydration-value');
    if (hydrationValue) hydrationValue.textContent = `${state.hydration}%`;

    const wholeGrainValue = document.getElementById('whole-grain-value');
    if (wholeGrainValue) wholeGrainValue.textContent = `${state.wholeGrain}%`;

    const saltValue = document.getElementById('salt-value');
    if (saltValue) saltValue.textContent = `${state.salt}%`;

    // Update Yeast tab
    const yeastPercentValue = document.getElementById('yeast-percent-value');
    if (yeastPercentValue) yeastPercentValue.textContent = `${state.yeastPercent}%`;

    const yeastPercentLabel = document.getElementById('yeast-percent-label');
    if (yeastPercentLabel) {
      yeastPercentLabel.textContent = state.yeastType === 'starter' ? 'Starter Amount' : 'Yeast Amount';
    }

    // Update yeast percent slider range based on type
    const yeastPercentSlider = document.getElementById('yeast-percent-slider') as HTMLInputElement;
    if (yeastPercentSlider) {
      const range = calc.yeastSliderRange(state.yeastType);
      yeastPercentSlider.min = String(range.min);
      yeastPercentSlider.max = String(range.max);
      yeastPercentSlider.step = String(range.step);
      yeastPercentSlider.value = String(state.yeastPercent);
      // In a sourdough recipe a levain replaces the starter row, so this amount is not used
      const levainIsStarter = state.yeastType === 'starter' && state.prefermentType === 'levain';
      yeastPercentSlider.disabled = levainIsStarter;
      document.getElementById('yeast-levain-note')?.classList.toggle('hidden', !levainIsStarter);
    }

    // Show/hide starter-specific controls
    const starterHydrationControl = document.getElementById('starter-hydration-control');
    const starterContributionEl = document.getElementById('starter-contribution');
    if (starterHydrationControl && starterContributionEl) {
      if (state.yeastType === 'starter') {
        starterHydrationControl.classList.remove('hidden');
        starterContributionEl.classList.remove('hidden');
        // Update starter contribution display
        const flourContrib = document.getElementById('starter-flour-contrib');
        const waterContrib = document.getElementById('starter-water-contrib');
        if (flourContrib) flourContrib.textContent = formatWeight(recipe.starterFlourContrib);
        if (waterContrib) waterContrib.textContent = formatWeight(recipe.starterWaterContrib);
      } else {
        starterHydrationControl.classList.add('hidden');
        starterContributionEl.classList.add('hidden');
      }
    }

    const starterHydrationValue = document.getElementById('starter-hydration-value');
    if (starterHydrationValue) starterHydrationValue.textContent = `${state.starterHydration}%`;

    // Update yeast tip
    const yeastTipText = document.getElementById('yeast-tip-text');
    if (yeastTipText) {
      yeastTipText.textContent = YEAST_TIPS[state.yeastType] || YEAST_TIPS['instant'];
    }

    // Update Temperature tab
    const ddtValue = document.getElementById('ddt-value');
    if (ddtValue) ddtValue.textContent = formatTemp(state.ddt);

    const roomTempValue = document.getElementById('room-temp-value');
    if (roomTempValue) roomTempValue.textContent = formatTemp(state.roomTemp);

    const flourTempValue = document.getElementById('flour-temp-value');
    if (flourTempValue) flourTempValue.textContent = formatTemp(state.flourTemp);

    const frictionValue = document.getElementById('friction-value');
    if (frictionValue) frictionValue.textContent = calc.formatTempDifference(state, state.frictionFactor);

    // Update calculated water temperature
    const calcWaterTemp = document.getElementById('calc-water-temp');
    if (calcWaterTemp) {
      calcWaterTemp.textContent = formatTemp(recipe.calculatedWaterTemp);
    }

    // Update water temp formula display
    const waterTempFormula = document.getElementById('water-temp-formula');
    if (waterTempFormula) {
      waterTempFormula.textContent = calc.waterTempFormulaText(state, recipe.calculatedWaterTemp);
    }

    // Show/hide water temp warning
    const waterTempWarning = document.getElementById('water-temp-warning');
    if (waterTempWarning) {
      const warning = calc.waterTempWarningText(recipe.calculatedWaterTemp);
      if (warning) {
        waterTempWarning.textContent = warning;
        waterTempWarning.classList.remove('hidden');
      } else {
        waterTempWarning.classList.add('hidden');
      }
    }

    // Update Timing tab
    const fermentTimes = estimateFermentationTimes();

    const bulkTime = document.getElementById('bulk-time');
    if (bulkTime) bulkTime.textContent = fermentTimes.bulk;

    const proofTime = document.getElementById('proof-time');
    if (proofTime) proofTime.textContent = fermentTimes.proof;

    const totalTime = document.getElementById('total-time');
    if (totalTime) totalTime.textContent = fermentTimes.total;

    // Update timing descriptions based on yeast type
    const bulkDescription = document.getElementById('bulk-description');
    if (bulkDescription) {
      if (state.yeastType === 'starter') {
        bulkDescription.textContent = 'Look for 50-75% rise with visible bubbles. Dough should be airy and jiggly.';
      } else if (state.yeastPercent < 0.5) {
        bulkDescription.textContent = 'Long, slow ferment develops flavor. Dough should be bubbly and doubled.';
      } else {
        bulkDescription.textContent = 'Look for doubled volume with a domed surface.';
      }
    }

    const proofDescription = document.getElementById('proof-description');
    if (proofDescription) {
      if (state.coldRetard) {
        proofDescription.textContent = 'Cold proof in refrigerator. Bake straight from cold or let warm 30 min.';
      } else {
        proofDescription.textContent = 'Poke test: dough should spring back slowly but not completely.';
      }
    }

    // Update total time note
    const totalTimeNote = document.getElementById('total-time-note');
    if (totalTimeNote) {
      if (state.coldRetard) {
        totalTimeNote.textContent = 'Plus 8-18 hours cold retard in refrigerator';
      } else {
        totalTimeNote.textContent = 'Active time from mixing to baking';
      }
    }

    // Show/hide cold retard info
    const coldRetardInfo = document.getElementById('cold-retard-info');
    if (coldRetardInfo) {
      if (state.coldRetard) {
        coldRetardInfo.classList.remove('hidden');
      } else {
        coldRetardInfo.classList.add('hidden');
      }
    }

    // Update preferment UI if the function is defined
    if (typeof updatePrefermentUI === 'function') {
      updatePrefermentUI();
    }

    // The Effective Hydration box follows every change, not only the Enrichments tab's own:
    // the hydration slider, the batch size and the style cards all move it
    updateEnrichmentDisplay();
  }

