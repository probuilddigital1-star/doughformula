  // Puts the Enrichments tab's switches and fields in line with enrichmentState, after a
  // style card set it
  function syncEnrichmentControls() {
    const set = (toggleId: string, controlsId: string, enabled: boolean) => {
      const toggle = document.getElementById(toggleId) as HTMLInputElement | null;
      if (toggle) toggle.checked = enabled;
      document.getElementById(controlsId)?.classList.toggle('hidden', !enabled);
    };
    const value = (id: string, v: string | number) => {
      const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
      if (el) el.value = String(v);
    };
    set('enrichment-fat-toggle', 'fat-controls', enrichmentState.fat.enabled);
    value('fat-type-select', enrichmentState.fat.type);
    value('fat-percent', enrichmentState.fat.percent);
    set('enrichment-egg-toggle', 'egg-controls', enrichmentState.eggs.enabled);
    value('egg-type-select', enrichmentState.eggs.type);
    value('egg-count', enrichmentState.eggs.count);
    set('enrichment-dairy-toggle', 'dairy-controls', enrichmentState.dairy.enabled);
    value('dairy-type-select', enrichmentState.dairy.type);
    value('dairy-percent', enrichmentState.dairy.percentOfLiquid);
    set('enrichment-sweet-toggle', 'sweet-controls', enrichmentState.sweet.enabled);
    value('sweet-type-select', enrichmentState.sweet.type);
    value('sweet-percent', enrichmentState.sweet.percent);
    updateEggWeight();
  }

