                  </div>

                  <!-- Whole Grain Summary -->
                  <div class="bg-[var(--cream-warm)] rounded-lg p-3">
                    <div class="flex items-center justify-between">
                      <span class="text-sm text-[var(--crust-brown)]">Total Whole Grain:</span>
                      <span class="font-medium text-[var(--espresso)]" id="total-whole-grain">10%</span>
