  // Open schedule modal
  document.getElementById('plan-bake-btn')?.addEventListener('click', () => {
    const modal = document.getElementById('schedule-modal');
    const dateInput = document.getElementById('schedule-date') as HTMLInputElement;

    // Set default date to tomorrow
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    if (dateInput) {
      dateInput.value = tomorrow.toISOString().split('T')[0];
    }

    modal?.classList.remove('hidden');
  });

  // Close schedule modal
  document.getElementById('schedule-modal-close')?.addEventListener('click', () => {
    document.getElementById('schedule-modal')?.classList.add('hidden');
  });

  document.getElementById('schedule-modal-overlay')?.addEventListener('click', () => {
    document.getElementById('schedule-modal')?.classList.add('hidden');
  });

  // Schedule presets
  document.querySelectorAll('.schedule-preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const el = btn as HTMLElement;
      const preset = el.dataset.preset;
      const dateInput = document.getElementById('schedule-date') as HTMLInputElement;
      const timeInput = document.getElementById('schedule-time') as HTMLInputElement;

      const tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);

      if (dateInput) {
        dateInput.value = tomorrow.toISOString().split('T')[0];
      }

      if (timeInput) {
        switch (preset) {
          case 'morning':
            timeInput.value = '09:00';
            break;
          case 'lunch':
            timeInput.value = '12:00';
            break;
          case 'dinner':
            timeInput.value = '18:00';
            break;
        }
      }
    });
  });

  // Generate schedule
  document.getElementById('generate-schedule-btn')?.addEventListener('click', async () => {
    const dateInput = document.getElementById('schedule-date') as HTMLInputElement;
    const timeInput = document.getElementById('schedule-time') as HTMLInputElement;
    const resultDiv = document.getElementById('schedule-result');
    const timeline = document.getElementById('schedule-timeline');

    if (!dateInput?.value || !timeInput?.value) return;

    const targetDate = new Date(`${dateInput.value}T${timeInput.value}`);
    const schedule = (await loadActions()).generateBakingSchedule(state, targetDate);

    if (timeline) {
      timeline.innerHTML = schedule.map(item => `
        <div class="schedule-item">
          <span class="schedule-item-time">${item.time}</span>
          <span class="schedule-item-task">${item.task}</span>
          <span class="schedule-item-duration">${item.duration}</span>
        </div>
      `).join('');
    }

    resultDiv?.classList.remove('hidden');
  });

  // Copy schedule
  document.getElementById('copy-schedule-btn')?.addEventListener('click', () => {
    const timeline = document.getElementById('schedule-timeline');
    if (timeline) {
      const text = Array.from(timeline.querySelectorAll('.schedule-item'))
        .map(item => {
          const time = item.querySelector('.schedule-item-time')?.textContent || '';
          const task = item.querySelector('.schedule-item-task')?.textContent || '';
          const duration = item.querySelector('.schedule-item-duration')?.textContent || '';
          return `${time} - ${task} (${duration})`;
        })
        .join('\n');

      navigator.clipboard.writeText(`Baking Schedule for ${state.style}:\n\n${text}`);
      showToast('Schedule copied to clipboard!');
    }
  });

  // Download ICS calendar file
  document.getElementById('download-ics-btn')?.addEventListener('click', async () => {
    const dateInput = document.getElementById('schedule-date') as HTMLInputElement;
    const timeInput = document.getElementById('schedule-time') as HTMLInputElement;

    if (!dateInput?.value || !timeInput?.value) return;

    const targetDate = new Date(`${dateInput.value}T${timeInput.value}`);
    const actions = await loadActions();
    const schedule = actions.generateBakingSchedule(state, targetDate);

    // Generate ICS file content
    const icsContent = actions.scheduleIcs(schedule, targetDate);

    // Download file
    const blob = new Blob([icsContent], { type: 'text/calendar' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `baking-schedule-${state.style}.ics`;
    a.click();
    URL.revokeObjectURL(url);

    showToast('Calendar file downloaded!');
  });

