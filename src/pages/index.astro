  // Tab scroll indicators for mobile
  const tabsWrapper = document.getElementById('tabs-wrapper');
  const tabsScroll = document.getElementById('tabs-scroll');
  const scrollHint = document.getElementById('scroll-hint');

  function updateScrollIndicators() {
    if (!tabsScroll || !tabsWrapper) return;

    const { scrollLeft, scrollWidth, clientWidth } = tabsScroll;
    const isAtStart = scrollLeft <= 5;
    const isAtEnd = scrollLeft + clientWidth >= scrollWidth - 5;

    // Toggle fade indicators
    tabsWrapper.classList.toggle('scrolled-start', !isAtStart);
    tabsWrapper.classList.toggle('scrolled-end', isAtEnd);

    // Show/hide scroll hint on mobile
    if (scrollHint) {
      if (window.innerWidth <= 640 && !isAtEnd) {
        scrollHint.classList.remove('hidden');
      } else {
        scrollHint.classList.add('hidden');
      }
    }
  }

