                    </p>
                  </div>

                  <!-- Total Time Estimate -->
                  <div class="bg-[var(--accent-gold)]/10 rounded-lg p-4 border border-[var(--accent-gold)]/20 mt-4">
                    <div class="flex items-center justify-between">
                      <span class="text-sm font-medium text-[var(--espresso)]">Total Active Time:</span>
                      <span class="text-lg font-display font-semibold text-[var(--accent-gold)]" id="total-time">{timesOnLoad.total}</span>
                    </div>
                    <p class="text-xs text-[var(--crust-brown)] mt-1" id="total-time-note">
                      Active time from mixing to baking
                    </p>
                  </div>

                  <!-- Plan My Bake Button -->
                  <button id="plan-bake-btn" class="btn btn-outline w-full text-sm py-3 mt-4">
                    <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
                    </svg>
                    Plan My Bake Schedule
                  </button>
                </div>

                <!-- Tab: Preferments -->
                <div class="advanced-tab-content hidden p-4 sm:p-6 space-y-4" id="tab-preferments">
                  <p class="text-sm text-[var(--crust-brown)] mb-2">
                    Add a preferment for improved flavor, extensibility, and keeping quality.
                  </p>

                  <!-- Preferment Type Selection -->
                  <div>
                    <label class="block text-sm mb-2">Preferment Type</label>
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" id="preferment-type-selector">
                      <button class="preferment-type-btn preferment-type-active" data-preferment="none">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                          <circle cx="12" cy="12" r="9"/>
                          <path d="M9 9l6 6M15 9l-6 6"/>
                        </svg>
                        <span>None</span>
                      </button>
                      <button class="preferment-type-btn" data-preferment="poolish">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                          <circle cx="12" cy="14" r="7"/>
                          <circle cx="9" cy="12" r="1" fill="currentColor"/>
                          <circle cx="15" cy="13" r="1.5" fill="currentColor"/>
                          <circle cx="12" cy="16" r="1" fill="currentColor"/>
