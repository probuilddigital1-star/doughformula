  // A number field's value, held to the field's own min and max. A typo or a minus sign can
  // not reach the recipe.
  function fieldNumber(input: HTMLInputElement, fallback: number, whole = true): number {
    const typed = whole ? parseInt(input.value) : parseFloat(input.value);
    return calc.clampToField(typed, Number(input.min), Number(input.max), fallback);
  }

