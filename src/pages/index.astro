  // Update enrichment display
  function updateEnrichmentDisplay() {
    const hasEnrichments = enrichmentState.fat.enabled || enrichmentState.eggs.enabled ||
                          enrichmentState.dairy.enabled || enrichmentState.sweet.enabled;

    const displayEl = document.getElementById('effective-hydration-display');
    if (displayEl) {
      displayEl.classList.toggle('hidden', !hasEnrichments);
    }

    if (hasEnrichments) {
      const recipe = calculateRecipe();
      const effectiveHydrationEl = document.getElementById('effective-hydration');
      if (effectiveHydrationEl) {
        effectiveHydrationEl.textContent = `${recipe.effectiveHydration}%`;
      }

      const targetHydrationEl = document.getElementById('target-hydration');
      if (targetHydrationEl) {
        targetHydrationEl.textContent = String(state.hydration);
      }

      const breakdownEl = document.getElementById('enrichment-breakdown');
      if (breakdownEl) {
        breakdownEl.innerHTML = recipe.enrichmentWater.breakdown.join(' · ');
      }
    }

    // Update enrichment tip based on what's enabled
    const tipEl = document.getElementById('enrichment-tip');
    if (tipEl) {
      if (enrichmentState.fat.enabled && enrichmentState.fat.percent > 15) {
        tipEl.textContent = 'High fat content: Add butter in stages after initial gluten development.';
      } else if (enrichmentState.sweet.enabled && enrichmentState.sweet.percent > 10) {
        tipEl.textContent = 'High sugar may slow yeast. Consider using osmotolerant yeast for very sweet doughs.';
      } else if (enrichmentState.eggs.enabled) {
        tipEl.textContent = 'Eggs add richness and help with browning. Room temperature eggs incorporate better.';
      } else {
        tipEl.textContent = 'Add fats after initial gluten development for better dough structure.';
      }
    }
  }

  // ============================================
  // Flour Management Event Listeners
  // ============================================

  // The flour each slot starts on when it is added
  const FLOUR_SLOT_DEFAULTS = ['bread', 'whole-wheat', 'rye-light'];

  // Puts the Flour tab's slots in line with flourDraft: one slot per flour in the draft
  function showFlourDraft() {
    for (let i = 0; i < 3; i++) {
      if (i > 0) document.getElementById(`flour-slot-${i}`)?.classList.toggle('hidden', i >= flourDraft.length);
      const typeSelect = document.querySelector(`.flour-type-select[data-flour="${i}"]`) as HTMLSelectElement | null;
      const percentInput = document.querySelector(`.flour-percent-input[data-flour="${i}"]`) as HTMLInputElement | null;
      if (typeSelect) typeSelect.value = flourDraft[i]?.type ?? FLOUR_SLOT_DEFAULTS[i];
      if (percentInput) percentInput.value = String(flourDraft[i]?.percent ?? 0);
    }
    document.getElementById('add-flour-btn')?.classList.toggle('hidden', flourDraft.length >= 3);
  }

  // After any change to the draft: use it for the recipe if it adds up to 100%, and say so
  // if it does not. The recipe keeps the last blend that did.
  function applyFlourDraft() {
    const total = flourDraft.reduce((sum, flour) => sum + flour.percent, 0);
    const valid = calc.isValidBlend(flourDraft);
    const validationEl = document.getElementById('flour-validation');
    if (validationEl) {
      validationEl.classList.toggle('hidden', valid);
      if (!valid) {
        validationEl.textContent = `Total flour must equal 100% (currently ${total}%). The recipe keeps your last blend until it does.`;
      }
    }
    if (valid) {
      flourBlend.splice(0, flourBlend.length, ...flourDraft.filter((flour) => flour.percent > 0).map((flour) => ({ ...flour })));
      // The Whole Grain slider on the Basics tab follows the blend
      state.wholeGrain = calc.calculateWholeGrainPercent(flourBlend);
      const slider = document.getElementById('whole-grain-slider') as HTMLInputElement | null;
      if (slider) slider.value = String(state.wholeGrain);
    }
    updateFlourDisplay();
  }

  // The Whole Grain slider and the style cards are the short way to set the blend: the main
  // flour plus that share of whole wheat.
  function setWholeGrain(percent: number, baseFlour?: string) {
    const base = baseFlour ?? flourBlend.find((flour) => !calc.FLOUR_DATA[flour.type]?.wholeGrain)?.type ?? 'bread';
    flourDraft = calc.blendForWholeGrain(percent, base);
    showFlourDraft();
    applyFlourDraft();
  }

  // Add flour button
  document.getElementById('add-flour-btn')?.addEventListener('click', () => {
    if (flourDraft.length < 3) {
      flourDraft.push({ type: FLOUR_SLOT_DEFAULTS[flourDraft.length], percent: 0 });
      showFlourDraft();
      applyFlourDraft();
      updateUI();
    }
  });

  // Remove flour buttons
  document.querySelectorAll('.remove-flour-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const index = parseInt((btn as HTMLElement).dataset.flour || '0');
      if (index > 0 && index < flourDraft.length) {
        flourDraft.splice(index, 1);
        showFlourDraft();
        applyFlourDraft();
        updateUI();
      }
    });
  });

  // Flour type selects
  document.querySelectorAll('.flour-type-select').forEach(select => {
    select.addEventListener('change', (e) => {
      const index = parseInt((e.target as HTMLSelectElement).dataset.flour || '0');
      if (!flourDraft[index]) return;
      flourDraft[index].type = (e.target as HTMLSelectElement).value;
      applyFlourDraft();
      updateUI();
    });
  });

  // Flour percent inputs
  document.querySelectorAll('.flour-percent-input').forEach(input => {
    input.addEventListener('input', (e) => {
      const index = parseInt((e.target as HTMLInputElement).dataset.flour || '0');
      if (!flourDraft[index]) return;
      flourDraft[index].percent = fieldNumber(e.target as HTMLInputElement, 0);
      applyFlourDraft();
      updateUI();
    });
  });

  // The whole grain summary under the blend
  function updateFlourDisplay() {
    const wholeGrainPercent = calc.calculateWholeGrainPercent(flourBlend);
    const totalWholeGrainEl = document.getElementById('total-whole-grain');
    if (totalWholeGrainEl) {
      totalWholeGrainEl.textContent = `${wholeGrainPercent}%`;
    }

    const tipEl = document.getElementById('whole-grain-tip');
    if (tipEl) {
      if (wholeGrainPercent > 30) {
        tipEl.textContent = 'High whole grain: Add 5-10% more water and consider a longer autolyse.';
      } else if (wholeGrainPercent > 10) {
        tipEl.textContent = 'Consider adding 2-5% more hydration for whole grains.';
      } else {
        tipEl.textContent = 'Mostly white flour: Standard hydration should work well.';
      }
    }
  }

  // Flour preset blends
  const FLOUR_PRESETS: Record<string, FlourEntry[]> = {
    classic: [{ type: 'bread', percent: 100 }],
    country: [{ type: 'bread', percent: 90 }, { type: 'whole-wheat', percent: 10 }],
    multigrain: [{ type: 'bread', percent: 70 }, { type: 'whole-wheat', percent: 20 }, { type: 'rye-light', percent: 10 }]
  };
  document.querySelectorAll('.flour-preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const preset = FLOUR_PRESETS[(btn as HTMLElement).dataset.blend || ''];
      if (!preset) return;
      flourDraft = preset.map((flour) => ({ ...flour }));
      showFlourDraft();
      applyFlourDraft();
      updateUI();
    });
  });

  // Sliders
  document.getElementById('hydration-slider')?.addEventListener('input', (e) => {
    state.hydration = parseFloat((e.target as HTMLInputElement).value);
    updateUI();
  });

  document.getElementById('whole-grain-slider')?.addEventListener('input', (e) => {
    setWholeGrain(parseFloat((e.target as HTMLInputElement).value));
    updateUI();
  });

  document.getElementById('salt-slider')?.addEventListener('input', (e) => {
    state.salt = parseFloat((e.target as HTMLInputElement).value);
    updateUI();
  });

  // Unit toggle
  function updateUnitToggle() {
    const on = ['bg-[var(--espresso)]', 'text-white'];
    const off = 'text-[var(--crust-brown)]';
    for (const unit of ['g', 'oz']) {
      const button = document.getElementById(`unit-${unit}`);
      if (!button) continue;
      const active = state.unit === unit;
      on.forEach((name) => button.classList.toggle(name, active));
      button.classList.toggle(off, !active);
    }
  }

  document.getElementById('unit-g')?.addEventListener('click', () => {
    state.unit = 'g';
    updateUnitToggle();
    updateUI();
  });

  document.getElementById('unit-oz')?.addEventListener('click', () => {
    state.unit = 'oz';
    updateUnitToggle();
    updateUI();
  });

  // Puts every control in line with the state, after a share link set it
  function syncControls() {
    const set = (id: string, value: string | number) => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (el) el.value = String(value);
    };
    const check = (id: string, checked: boolean) => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (el) el.checked = checked;
    };
    set('num-loaves', state.numLoaves);
    set('loaf-weight', state.loafWeight);
    set('hydration-slider', state.hydration);
    set('salt-slider', state.salt);
    set('starter-hydration-slider', state.starterHydration);
    set('ddt-slider', state.ddt);
    set('room-temp-slider', state.roomTemp);
    set('flour-temp-slider', state.flourTemp);
    set('preferment-percent-slider', state.prefermentPercent);
    check('cold-retard-toggle', state.coldRetard);
    check('autolyse-toggle', state.autolyse);
    document.getElementById('autolyse-controls')?.classList.toggle('hidden', !state.autolyse);
    document.querySelectorAll('.autolyse-duration-btn').forEach(btn => {
      btn.classList.toggle('autolyse-duration-active', (btn as HTMLElement).dataset.duration === String(state.autolyseDuration));
    });
    updateUnitToggle();
    updateYeastTypeButtons();
    updateMixerButtons();
    updateTempUnitToggle();
    updatePrefermentTypeButtons();
    syncEnrichmentControls();
  }

  // Toast helper
  function showToast(message: string) {
    const toast = document.getElementById('toast');
    if (toast) {
      toast.textContent = message;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 3000);
    }
  }

  // Action buttons
  document.getElementById('btn-print')?.addEventListener('click', () => {
    window.print();
  });

  document.getElementById('btn-copy')?.addEventListener('click', async () => {
    const recipe = calculateRecipe();
    const text = (await loadActions()).recipeCopyText(state, enrichmentState, recipe);

    try {
      await navigator.clipboard.writeText(text);
      showToast('Recipe copied to clipboard!');
    } catch {
      showToast('Could not copy recipe');
    }
  });

  document.getElementById('btn-share')?.addEventListener('click', async () => {
    // style, loaves, weight and hydration as always, then whatever else differs from the
    // style card: salt, yeast, flours, preferment, enrichments, units, temperatures, timing
    const url = new URL(window.location.href);
    url.search = '';
    for (const [key, value] of (await loadActions()).shareLinkParams(state, enrichmentState, flourBlend)) {
      url.searchParams.set(key, value);
    }

    try {
      await navigator.clipboard.writeText(url.toString());
      showToast('Recipe link copied!');
    } catch {
      showToast('Could not copy link');
    }
  });

  // FAQ toggles
  document.querySelectorAll('.faq-trigger').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const content = trigger.nextElementSibling;
      const chevron = trigger.querySelector('.faq-chevron') as HTMLElement;
      if (content && chevron) {
        content.classList.toggle('hidden');
        chevron.style.transform = content.classList.contains('hidden') ? '' : 'rotate(180deg)';
      }
    });
  });

  // Mobile menu
  document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.remove('translate-x-full');
  });

  document.getElementById('mobile-menu-close')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.add('translate-x-full');
  });

  document.querySelectorAll('.mobile-menu-link').forEach(link => {
    link.addEventListener('click', () => {
      document.getElementById('mobile-menu')?.classList.add('translate-x-full');
    });
  });

  // Newsletter form: client-side subscribe through Kit's v3 public-key endpoint.
  // The form only renders when src/config/newsletter.ts has both values set.
  const newsletterForm = document.getElementById('newsletter-form') as HTMLFormElement | null;
  if (newsletterForm) {
    const kitFormId = newsletterForm.dataset.kitFormId || '';
    const kitApiKey = newsletterForm.dataset.kitApiKey || '';
    newsletterForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = newsletterForm.querySelector('input[type="email"]') as HTMLInputElement | null;
      const email = input?.value.trim() || '';
      if (!email || !kitFormId || !kitApiKey) return;
      const button = newsletterForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (button) button.disabled = true;
      try {
        const res = await fetch(`https://api.convertkit.com/v3/forms/${kitFormId}/subscribe`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ api_key: kitApiKey, email }),
        });
        if (!res.ok) throw new Error(`Kit responded ${res.status}`);
        document.dispatchEvent(new CustomEvent('df:newsletter-submitted'));
        showToast("You're in! Check your inbox to confirm.");
        if (input) input.value = '';
      } catch {
        showToast('Something went wrong. Try again in a moment.');
      } finally {
        if (button) button.disabled = false;
      }
    });
  }

  // Load recipe from URL params
  function loadFromURL() {
    // parseUrlRecipeParams reads style, loaves, weight and hydration (50 to 95 only)
    const fromUrl = calc.parseUrlRecipeParams(new URLSearchParams(window.location.search));
    if (fromUrl.style !== undefined) {
      const styleCard = document.querySelector(`[data-style="${fromUrl.style}"]`) as HTMLElement;
      if (styleCard) {
        styleCard.click();
      }
    }
    calc.applyUrlRecipeParams(state, fromUrl);
    if (fromUrl.loaves !== undefined) {
      (document.getElementById('num-loaves') as HTMLInputElement).value = String(state.numLoaves);
    }
    if (fromUrl.weight !== undefined) {
      (document.getElementById('loaf-weight') as HTMLInputElement).value = String(state.loafWeight);
    }
    if (fromUrl.hydration !== undefined) {
      (document.getElementById('hydration-slider') as HTMLInputElement).value = String(fromUrl.hydration);
    }

    updateUI();

    // A share link can carry the rest of the recipe. A hand-off link carries none of it, so
    // the share code is fetched now only when the link has something more to read.
    const params = new URLSearchParams(window.location.search);
    const known = ['style', 'loaves', 'weight', 'hydration'];
    if ([...params.keys()].some((key) => !known.includes(key))) {
      loadActions().then((actions) => {
        const shared = actions.parseShareSettings(params);
        if (Object.keys(shared).length === 0) return;
        actions.applyShareSettings(state, enrichmentState, shared);
        if (shared.flours) {
          flourDraft = shared.flours.map((flour) => ({ ...flour }));
          showFlourDraft();
          applyFlourDraft();
        }
        syncControls();
        updateUI();
      });
    }
  }

  // Initialize. The server HTML already shows the default recipe, built by the same code
  // (see the frontmatter), so a plain visit has nothing to work out or draw: the first render
  // comes with the first change. A link that sets anything is read and rendered now.
  if (window.location.search) {
    updateMixerButtons();
    updateTempUnitToggle();
    loadFromURL();
    updateYeastTypeButtons();
  }
</script>
