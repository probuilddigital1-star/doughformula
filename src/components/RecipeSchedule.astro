---
import type { ScheduleStep } from '../lib/recipe-formula';
import { PRODUCTS, TRACKING_IDS, productUrl } from '../data/equipment';
import { affiliateLinkAttributes } from '../config/analytics';

const challenger = PRODUCTS['challenger-bread-pan'];
const challengerHref = productUrl(challenger, TRACKING_IDS.recipe, 'recipe_step');
const challengerAttrs = affiliateLinkAttributes(challenger, TRACKING_IDS.recipe, 'recipe_step');

interface Props {
  schedule: ScheduleStep[];
}

const { schedule } = Astro.props;
---

<section class="my-10 max-w-2xl mx-auto">
  <h2 class="font-display text-2xl mb-6">Schedule</h2>
  <ol class="space-y-4">
    {schedule.map((step) => (
      <li class="flex gap-4 pb-4 border-b border-[var(--border-light)] last:border-b-0">
        <div class="flex-shrink-0 w-32 text-sm font-medium text-[var(--accent-gold)] uppercase tracking-wider">
          {step.when}
        </div>
        <div class="flex-1 text-[var(--espresso)]">
          {step.action}
          {step.gearMention === 'challenger' && (
            <> A bread pan like the <a href={challengerHref} target="_blank" rel="sponsored nofollow noopener noreferrer" class="underline decoration-[var(--accent-gold)] underline-offset-2 hover:text-[var(--accent-gold)]" {...challengerAttrs}>Challenger</a> works here too.</>
          )}
        </div>
      </li>
    ))}
  </ol>
</section>
